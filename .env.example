# ---- Commander Daily configuration -------------------------------------------
# Everything here is optional; with no env vars at all the app runs on
# localhost:3000 with data in ./data/store.json.

# HTTP port (Render/Fly/Heroku inject their own PORT).
PORT=3000

# Signs the anonymous session cookie. If unset, a random one is generated at
# boot — which means every restart logs everyone out and their in-progress
# daily becomes unreachable. SET THIS IN PRODUCTION.
#   openssl rand -hex 32
SESSION_SECRET=

# Where the JSON store lives when using the file backend.
DATA_FILE=./data/store.json

# Store backend: "file" (default) or "upstash" (any Redis-REST endpoint).
# Free hosts that wipe the filesystem (Render free, Fly trial, most serverless)
# MUST use an external store or a restart will erase the daily + leaderboard.
STORE_BACKEND=file

# Upstash-compatible REST credentials (used when STORE_BACKEND=upstash).
# Vercel KV names also work: KV_REST_API_URL / KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORE_KEY=commander-daily:store:v1

# How long to debounce writes to the external store (ms). Larger = fewer
# Upstash commands; smaller = less to lose if the instance dies mid-write.
STORE_FLUSH_MS=1500

# Guard /api/store-stats (player counts). Leave blank to expose it publicly.
ADMIN_TOKEN=

# Force the Secure flag on the session cookie (automatic behind a proxy that
# sends X-Forwarded-Proto: https).
COOKIE_SECURE=

# Hard cap on request bodies (bytes) — the deck importer is the biggest caller.
MAX_BODY_BYTES=262144
